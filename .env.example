# ==============================================================================
# Text-to-SQL Agent Configuration Template
# Copy this file to .env and adjust values as needed.
# NEVER commit real credentials to version control.
# ==============================================================================

# LLM Provider Options: "deterministic" (default for offline/testing), "ollama", "openai", "gemini"
LLM_PROVIDER=deterministic

# Embedding Provider Options: "deterministic" (default for offline/testing), "ollama", "openai", "gemini"
EMBEDDING_PROVIDER=deterministic

# Ollama Endpoint Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5-coder:7b

# Cloud API Keys (Leave empty if using Ollama or Deterministic mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Settings
DATABASE_PATH=business.db

# Vector Storage Directory
CHROMA_PERSIST_DIR=./chroma_data

# Security and Execution Constraints
MAX_RETRIES=2
QUERY_TIMEOUT_SECONDS=5.0
MAX_RESULT_ROWS=100
ALLOWED_TABLES=customers,products,orders,order_items

# Logging Configuration
LOG_LEVEL=INFO
